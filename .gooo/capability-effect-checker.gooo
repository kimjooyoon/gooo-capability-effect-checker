gooo 2
package capability_effect_checker
namespace gooo://capability-effect-checker/v2

# This file is the only semantic authority. Go is parser, typechecker,
# evaluator, and generator; no Go source may mint a capability or effect.
effect READ_INPUT
effect NETWORK_READ_PINNED
effect GENERATE_CALLER_OUTPUT
effect REPOSITORY_WRITE
effect REMOTE_MUTATION
effect DESTRUCTIVE_DELETE

